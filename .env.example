NODE_ENV=production
DB_HOST=your-aiven-host
DB_PORT=your-aiven-service-port
DB_NAME=defaultdb
DB_USER=your-runtime-user
DB_PASSWORD=your-database-password
# Render: upload your Aiven CA as a Secret File named aiven-ca.pem.
DB_SSL_CA_PATH=/etc/secrets/aiven-ca.pem
# Alternative to a file: DB_SSL_CA can contain the certificate's PEM text.
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-characters
FRONTEND_URL=https://your-frontend.onrender.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key-not-smtp-key
EMAIL_FROM=your-verified-clinic-sender@gmail.com
EMAIL_FROM_NAME=Magno Dental Clinic
EMAIL_USER=your-clinic@gmail.com
EMAIL_REPLY_TO=your-clinic@gmail.com
EMAIL_TIMEOUT_MS=10000
# PORT is supplied by Render. For local testing only, use PORT=3001.
# TRUST_PROXY_HOPS is optional; set only after confirming your reverse-proxy topology.
